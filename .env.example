# ─────────────────────────────────────────────────────────────
# LeetTrack AI — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string — the POOLED endpoint, used by the running app.
#   Neon:     the host WITH "-pooler"  (…-pooler.<region>.aws.neon.tech)
#   Supabase: the "Transaction" pooler (port 6543)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct, NON-pooled connection — used only by Prisma Migrate.
#   Neon:     the same host WITHOUT "-pooler"
#   Supabase: the direct connection (port 5432)
#   Plain Postgres: same value as DATABASE_URL
#
# This must not point at the pooler. Prisma Migrate takes a session-scoped
# advisory lock; PgBouncer keeps the backend session alive after Prisma
# disconnects, so the lock leaks and every later migration hangs with
# "Timed out trying to acquire a postgres advisory lock".
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth. Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Optional. Auth.js runs with `trustHost: true`, so it derives the callback URL
# from the incoming request — leave this unset for local development and Vercel.
# Set it only when the app sits behind a proxy that rewrites the Host header.
# AUTH_URL="https://leettrack.vercel.app"

# Seeded administrator credentials (the ONLY account that can sign in).
ADMIN_EMAIL="abishstk@gmail.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="VSBCETC Administrator"

# Shared secret protecting POST /api/sync so GitHub Actions can trigger the
# daily job. Generate with:  openssl rand -hex 32
CRON_SECRET="replace-me-with-a-random-hex-string"

# Public base URL of the deployed app (used by the GitHub Actions workflow).
APP_URL="http://localhost:3000"

# Sync tuning (optional — sensible defaults are applied).
SYNC_CONCURRENCY="4"
SYNC_DELAY_MS="350"
SYNC_MAX_RETRIES="3"
